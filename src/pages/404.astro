---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import CosmicBackground from "@/components/celestial/CosmicBackground";
import UrlParamsSync from "@/components/ui/UrlParamsSync.astro";

Astro.response.status = 404;
---

<BaseLayout
  title="404 — Versículos Bíblicos"
  description="La página solicitada no fue encontrada."
  lang="es"
>
  <CosmicBackground client:idle />
  <main class="relative z-10 mx-auto flex min-h-dvh w-full max-w-3xl items-center justify-center px-3 py-10 sm:px-4">
    <section class="w-full max-w-xl rounded-2xl border border-gold-500/25 bg-[#0e132d]/70 p-6 text-center shadow-[0_0_22px_rgba(0,0,0,0.35)] backdrop-blur-sm sm:p-8">
      <img
        src="/img/logo-refugio-celestial-best.png"
        alt="Versículos Bíblicos"
        class="mx-auto mb-4 h-16 w-16 rounded-full border border-gold-500/30 object-cover"
      />
      <p class="font-display text-3xl font-bold tracking-[0.12em] text-gold-200 sm:text-4xl">404</p>
      <p class="mt-3 text-base text-gold-100/90 sm:text-lg">
        <span class="i18n-es">No encontramos esta página.</span>
        <span class="i18n-en hidden" aria-hidden="true">We couldn't find this page.</span>
      </p>
      <p class="mt-2 text-sm text-gold-300/70">
        <span class="i18n-es">Tal vez el enlace cambió o ya no existe.</span>
        <span class="i18n-en hidden" aria-hidden="true">The link may have changed or no longer exists.</span>
      </p>
      <blockquote class="mx-auto mt-5 max-w-md rounded-xl border border-gold-500/20 bg-black/25 px-4 py-3">
        <p class="text-sm italic leading-relaxed text-gold-100/85">
          <span class="i18n-es">“Yo soy el camino, y la verdad, y la vida.”</span>
          <span class="i18n-en hidden" aria-hidden="true">“I am the way and the truth and the life.”</span>
        </p>
        <cite class="mt-1 block text-xs font-semibold not-italic tracking-wide text-gold-300/80">
          <span class="i18n-es">Juan 14:6</span>
          <span class="i18n-en hidden" aria-hidden="true">John 14:6</span>
        </cite>
      </blockquote>
      <div class="mt-6 flex flex-col items-center justify-center gap-2 sm:flex-row sm:gap-3">
        <a
          href="/"
          class="inline-flex min-h-11 items-center justify-center rounded-full border border-gold-500/40 bg-gold-500/10 px-6 py-2 text-sm font-semibold text-gold-100 transition hover:border-gold-400 hover:bg-gold-500/20"
        >
          <span class="i18n-es">Volver al inicio</span>
          <span class="i18n-en hidden" aria-hidden="true">Back to home</span>
        </a>
        <a
          href="/lectura"
          class="inline-flex min-h-11 items-center justify-center rounded-full border border-gold-500/25 bg-black/25 px-6 py-2 text-sm font-semibold text-gold-100/90 transition hover:border-gold-500/40 hover:bg-black/35"
        >
          <span class="i18n-es">Ir a la lectura bíblica</span>
          <span class="i18n-en hidden" aria-hidden="true">Go to Bible reading</span>
        </a>
      </div>
    </section>
  </main>
  <UrlParamsSync />
</BaseLayout>
