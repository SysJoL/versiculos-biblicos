---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import CosmicBackground from "@/components/celestial/CosmicBackground";
import SiteHeader from "@/components/celestial/SiteHeader.astro";
import StreakBadge from "@/components/celestial/StreakBadge.astro";
import UrlParamsSync from "@/components/ui/UrlParamsSync.astro";
import VisualSanctuarySwitcher from "@/components/celestial/VisualSanctuarySwitcher";
---

<BaseLayout
  title="Favoritos — Versículos Bíblicos"
  description="Tus versículos guardados, disponibles sin conexión."
  lang="es"
>
  <CosmicBackground client:idle />
  <SiteHeader currentLang="es" currentMood="all" showMoodBar={false} showFavoritesLink={false} />
  <main
    class="pointer-events-auto relative z-10 mx-auto flex min-h-dvh w-full max-w-3xl flex-col px-3 pb-10 pt-[calc(5rem+env(safe-area-inset-top,0px))] sm:px-4 sm:pt-[calc(5.25rem+env(safe-area-inset-top,0px))] md:px-6 md:pt-[calc(6rem+env(safe-area-inset-top,0px))] lg:px-8"
  >
    <div class="mt-2 flex flex-1 flex-col items-center py-2 sm:py-4">
      <div class="mb-3">
        <StreakBadge />
      </div>
      <section class="w-full max-w-2xl" aria-live="polite">
        <h1 class="font-display text-xl font-bold text-gold-300 sm:text-2xl">
          <span class="i18n-es">Versículos favoritos</span>
          <span class="i18n-en hidden" aria-hidden="true">Favorite verses</span>
        </h1>
        <p class="mt-0.5 text-xs text-gold-100/60 sm:text-sm">
          <span class="i18n-es" data-fav-count>Guardados en este dispositivo, disponibles sin conexión.</span>
          <span class="i18n-en hidden" aria-hidden="true" data-fav-count-en>Saved on this device, available offline.</span>
        </p>

        <div id="refugio-fav-empty" class="mt-6 hidden rounded-2xl border border-gold-500/25 bg-black/40 p-6 text-center backdrop-blur-md">
          <i class="fa-regular fa-heart text-2xl text-gold-300/70" aria-hidden="true"></i>
          <p class="mt-3 text-sm text-gold-100/90">
            <span class="i18n-es">Aún no tienes favoritos. Toca el corazón en cualquier versículo para guardarlo aquí.</span>
            <span class="i18n-en hidden" aria-hidden="true">No favorites yet. Tap the heart on any verse to save it here.</span>
          </p>
          <a
            href="/"
            class="mt-4 inline-flex min-h-11 items-center justify-center rounded-full border border-gold-500/40 bg-gold-500/10 px-6 py-2 text-sm font-semibold text-gold-100 transition hover:border-gold-400 hover:bg-gold-500/20"
          >
            <span class="i18n-es">Ver el versículo del día</span>
            <span class="i18n-en hidden" aria-hidden="true">See today's verse</span>
          </a>
        </div>

        <ul id="refugio-fav-list" class="mt-4 space-y-3"></ul>
      </section>
    </div>
    <footer class="mt-6 border-t border-gold-500/15 pt-3 text-center text-xs text-gold-300/70">
      <a
        href="/"
        class="font-semibold text-gold-300 transition hover:text-gold-200 hover:underline"
      >
        <i class="fa-solid fa-arrow-left mr-1" aria-hidden></i>
        <span class="i18n-es">Volver al versículo del día</span>
        <span class="i18n-en hidden" aria-hidden="true">Back to daily verse</span>
      </a>
    </footer>
  </main>
  <UrlParamsSync />
  <VisualSanctuarySwitcher client:load />
</BaseLayout>

<script is:inline>
  (() => {
    const LS_KEY = "refugio.favorites.v1";
    const list = document.getElementById("refugio-fav-list");
    const empty = document.getElementById("refugio-fav-empty");
    if (!list || !empty) return;

    const lang = () =>
      document.documentElement.getAttribute("data-url-lang") === "en" ? "en" : "es";

    const esc = (s) =>
      String(s ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");

    const toast = (message, kind) => {
      window.dispatchEvent(
        new CustomEvent("refugio:toast", { detail: { message, kind: kind || "success", durationMs: 2000 } })
      );
    };

    const read = () => {
      try {
        const raw = localStorage.getItem(LS_KEY);
        if (!raw) return [];
        const arr = JSON.parse(raw);
        return Array.isArray(arr) ? arr.filter((f) => f && f.key && f.ref && f.text) : [];
      } catch {
        return [];
      }
    };

    const render = () => {
      const L = lang();
      const favs = read();
      list.innerHTML = "";
      empty.classList.toggle("hidden", favs.length > 0);

      const openLabel = L === "es" ? "Abrir" : "Open";
      const copyLabel = L === "es" ? "Copiar" : "Copy";
      const removeLabel = L === "es" ? "Quitar" : "Remove";

      favs.forEach((f) => {
        const li = document.createElement("li");
        li.className =
          "rounded-2xl border border-gold-500/25 bg-black/40 p-4 backdrop-blur-md transition hover:border-gold-500/40 sm:p-5";
        const date = (() => {
          try {
            return f.savedAt ? new Date(f.savedAt).toLocaleDateString(L === "es" ? "es-ES" : "en-US", { day: "numeric", month: "short", year: "numeric" }) : "";
          } catch {
            return "";
          }
        })();
        li.innerHTML =
          `<p class="font-display text-sm font-semibold tracking-wide text-gold-300">${esc(f.ref)}` +
          (date ? ` <span class="ml-1 text-[11px] font-normal text-gold-200/50">· ${esc(date)}</span>` : "") +
          `</p>` +
          `<p class="mt-1.5 text-[15px] leading-relaxed text-gold-50/90">${esc(f.text)}</p>` +
          `<div class="mt-3 flex flex-wrap items-center gap-2">` +
          (f.url
            ? `<a href="${esc(f.url)}" class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-gold-500/40 bg-gold-500/10 px-4 text-xs font-semibold text-gold-100 transition hover:bg-gold-500/20"><i class="fa-solid fa-book-open" aria-hidden="true"></i>${openLabel}</a>`
            : "") +
          `<button type="button" data-act="copy" class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-white/10 px-4 text-xs font-semibold text-gold-100/90 transition hover:bg-white/5"><i class="fa-solid fa-copy" aria-hidden="true"></i>${copyLabel}</button>` +
          `<button type="button" data-act="remove" class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-white/10 px-4 text-xs font-semibold text-gold-100/90 transition hover:bg-white/5 hover:text-rose-200"><i class="fa-solid fa-trash-can" aria-hidden="true"></i>${removeLabel}</button>` +
          `</div>`;

        const btnCopy = li.querySelector('[data-act="copy"]');
        const btnRemove = li.querySelector('[data-act="remove"]');
        btnCopy?.addEventListener("click", async () => {
          const value = `“${f.text}” — ${f.ref}`;
          try {
            if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(value);
            } else {
              const ta = document.createElement("textarea");
              ta.value = value;
              ta.style.position = "fixed";
              ta.style.opacity = "0";
              document.body.appendChild(ta);
              ta.select();
              document.execCommand("copy");
              ta.remove();
            }
            toast(L === "es" ? "Texto copiado al portapapeles." : "Text copied to clipboard.");
          } catch {
            toast(L === "es" ? "No se pudo copiar el texto." : "Could not copy text.", "error");
          }
        });
        btnRemove?.addEventListener("click", () => {
          try {
            const next = read().filter((x) => x.key !== f.key);
            localStorage.setItem(LS_KEY, JSON.stringify(next));
          } catch {
            // almacenamiento no disponible
          }
          render();
          toast(L === "es" ? "Quitado de favoritos." : "Removed from favorites.");
        });
        list.appendChild(li);
      });
    };

    render();
    window.addEventListener("refugio-favorites-changed", render);
  })();
</script>
