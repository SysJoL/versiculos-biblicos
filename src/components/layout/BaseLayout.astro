---
import "@/styles/global.css";
import "@fortawesome/fontawesome-free/css/fontawesome.min.css";
import "@fortawesome/fontawesome-free/css/solid.min.css";
import "@fortawesome/fontawesome-free/css/regular.min.css";
import ToastHost from "@/components/ui/ToastHost.astro";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
}

const { title, lang = "es", description = lang === "es" ? "Meditación bíblica con versículo del día y descarga de imagen." : "Biblical meditation with a daily verse and image download.", ogTitle, ogDescription, ogImage = "/img/logo-refugio-celestial-best.png", ogUrl } = Astro.props;
const shareTitle = ogTitle ?? title;
const shareDescription = ogDescription ?? description;

const CSP = "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://bible-api.com; frame-ancestors 'none'; form-action 'self'";
Astro.response.headers.set("content-security-policy", CSP);
---

<!doctype html>
<html lang={lang} class="scroll-smooth" data-url-lang={lang} data-url-mood="all">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f24" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Versículos Bíblicos" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:image" content={ogImage} />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/img/icon-192.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon-180.png" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var KEY = "refugio-celestial:sanctuary-theme";
          var meta = document.querySelector('meta[name="theme-color"]');
          var apply = function (theme) {
            var t = theme === "nature" ? "nature" : "celestial";
            document.documentElement.setAttribute("data-sanctuary", t);
            if (meta) meta.setAttribute("content", t === "nature" ? "#081208" : "#0b0f24");
          };
          apply(localStorage.getItem(KEY));
          window.addEventListener("refugio-sanctuary-changed", function (e) {
            apply(e && e.detail && e.detail.theme);
          });
        } catch (err) {}
      })();
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[200] focus:rounded-lg focus:border focus:border-gold-500/50 focus:bg-night focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-gold-100 focus:shadow-lg"
    >
      <span class="i18n-es">Saltar al contenido</span>
      <span class="i18n-en hidden" aria-hidden="true">Skip to content</span>
    </a>
    <slot />
    <ToastHost />
  </body>
</html>
